{
  "title": "hrGuard - API 모니터링",
  "uid": "hrguard-api",
  "schemaVersion": 38,
  "version": 6,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["api", "hrguard"],
  "panels": [

    {
      "id": 1, "type": "row",
      "title": "▶  HTTP 요청 현황",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 10, "type": "stat",
      "title": "현재 RPS",
      "description": "초당 요청 수 (/actuator 제외)",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#8AB8FF", "value": null }] }
        }
      },
      "targets": [{
        "expr": "sum(rate(http_server_requests_seconds_count{job=\"hrguard-api\", uri!~\"/actuator.*\"}[$__rate_interval]))",
        "legendFormat": "RPS", "refId": "A"
      }]
    },

    {
      "id": 11, "type": "stat",
      "title": "평균 응답 시간",
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#3274D9", "value": null }, { "color": "#E0B400", "value": 0.3 }, { "color": "#E02F44", "value": 1 }] }
        }
      },
      "targets": [{
        "expr": "sum(rate(http_server_requests_seconds_sum{job=\"hrguard-api\", uri!~\"/actuator.*\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{job=\"hrguard-api\", uri!~\"/actuator.*\"}[$__rate_interval]))",
        "legendFormat": "avg", "refId": "A"
      }]
    },

    {
      "id": 12, "type": "stat",
      "title": "p95 응답 시간",
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#3274D9", "value": null }, { "color": "#E0B400", "value": 0.5 }, { "color": "#E02F44", "value": 2 }] }
        }
      },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"hrguard-api\", uri!~\"/actuator.*\"}[$__rate_interval])) by (le))",
        "legendFormat": "p95", "refId": "A"
      }]
    },

    {
      "id": 13, "type": "stat",
      "title": "5xx 에러율",
      "description": "전체 요청 대비 5xx 비율. 1% 이상이면 즉시 확인.",
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#3274D9", "value": null }, { "color": "#E0B400", "value": 0.1 }, { "color": "#E02F44", "value": 1 }] }
        }
      },
      "targets": [{
        "expr": "sum(rate(http_server_requests_seconds_count{job=\"hrguard-api\", status=~\"5..\", uri!~\"/actuator.*\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{job=\"hrguard-api\", uri!~\"/actuator.*\"}[$__rate_interval])) * 100",
        "legendFormat": "5xx %", "refId": "A"
      }]
    },

    {
      "id": 14, "type": "timeseries",
      "title": "RPS & 5xx 에러 추이",
      "description": "에러 급증 시 배포·DB·외부 API 문제 우선 확인.",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "5xx 에러" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#E02F44", "mode": "fixed" } }, { "id": "custom.fillOpacity", "value": 30 }] }
        ]
      },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{job=\"hrguard-api\", uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "전체 RPS", "refId": "A" },
        { "expr": "sum(rate(http_server_requests_seconds_count{job=\"hrguard-api\", status=~\"5..\", uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "5xx 에러", "refId": "B" },
        { "expr": "sum(rate(http_server_requests_seconds_count{job=\"hrguard-api\", status=~\"4..\", uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "4xx 클라이언트 오류", "refId": "C" }
      ]
    },

    {
      "id": 15, "type": "timeseries",
      "title": "응답 시간 분포 (avg / p95 / p99)",
      "description": "p99와 평균의 격차가 크면 일부 요청에서 극단적 지연 발생 중.",
      "gridPos": { "x": 0, "y": 11, "w": 24, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 5 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p99" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#E02F44", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p95" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#E0B400", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_sum{job=\"hrguard-api\", uri!~\"/actuator.*\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{job=\"hrguard-api\", uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "avg", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"hrguard-api\", uri!~\"/actuator.*\"}[$__rate_interval])) by (le))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=\"hrguard-api\", uri!~\"/actuator.*\"}[$__rate_interval])) by (le))", "legendFormat": "p99", "refId": "C" }
      ]
    },

    {
      "id": 16, "type": "timeseries",
      "title": "URI별 평균 응답 시간",
      "description": "느린 엔드포인트를 특정. 상위 5개 URI만 표시하려면 Grafana Legend 필터 활용.",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 1 } } },
      "targets": [{
        "expr": "sum by (uri) (rate(http_server_requests_seconds_sum{job=\"hrguard-api\", uri!~\"/actuator.*\"}[$__rate_interval])) / sum by (uri) (rate(http_server_requests_seconds_count{job=\"hrguard-api\", uri!~\"/actuator.*\"}[$__rate_interval]))",
        "legendFormat": "{{uri}}", "refId": "A"
      }]
    },

    {
      "id": 17, "type": "timeseries",
      "title": "HTTP 상태 코드별 RPS",
      "description": "2xx/3xx/4xx/5xx 분포로 전체 트래픽 건강도 파악.",
      "gridPos": { "x": 0, "y": 25, "w": 24, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 8 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [{ "id": "color", "value": { "fixedColor": "#E02F44", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "4xx" }, "properties": [{ "id": "color", "value": { "fixedColor": "#E0B400", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "2xx" }, "properties": [{ "id": "color", "value": { "fixedColor": "#3274D9", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{job=\"hrguard-api\", status=~\"2..\", uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "2xx", "refId": "A" },
        { "expr": "sum(rate(http_server_requests_seconds_count{job=\"hrguard-api\", status=~\"4..\", uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "4xx", "refId": "B" },
        { "expr": "sum(rate(http_server_requests_seconds_count{job=\"hrguard-api\", status=~\"5..\", uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "5xx", "refId": "C" }
      ]
    },


    {
      "id": 50, "type": "row",
      "title": "▶  시스템 리소스",
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 51, "type": "row",
      "title": "JVM 메모리",
      "gridPos": { "x": 0, "y": 33, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 52, "type": "timeseries",
      "title": "Heap 사용량",
      "description": "OOM 위험을 사전에 감지합니다. 트래픽 급증 시 Used가 Max에 가까워지면 -Xmx 증설 또는 누수 점검.",
      "gridPos": { "x": 0, "y": 34, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 1, "fillOpacity": 20 } } },
      "targets": [
        { "expr": "jvm_memory_used_bytes{job=\"hrguard-api\", area=\"heap\"}", "legendFormat": "Heap 사용 ({{id}})", "refId": "A" },
        { "expr": "jvm_memory_max_bytes{job=\"hrguard-api\", area=\"heap\"}", "legendFormat": "Heap 최대 ({{id}})", "refId": "B" }
      ]
    },

    {
      "id": 53, "type": "timeseries",
      "title": "Non-Heap 사용량 (Metaspace / Code Cache)",
      "description": "Metaspace 무한 증가 시 클래스 로딩 누수 의심. 정상 운영 중에는 거의 고정값.",
      "gridPos": { "x": 12, "y": 34, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 1, "fillOpacity": 15 } } },
      "targets": [
        { "expr": "jvm_memory_used_bytes{job=\"hrguard-api\", area=\"nonheap\"}", "legendFormat": "Non-Heap 사용 ({{id}})", "refId": "A" },
        { "expr": "jvm_memory_committed_bytes{job=\"hrguard-api\", area=\"nonheap\"}", "legendFormat": "Non-Heap Committed ({{id}})", "refId": "B" }
      ]
    },

    {
      "id": 60, "type": "row",
      "title": "CPU & 스레드",
      "gridPos": { "x": 0, "y": 40, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 61, "type": "timeseries",
      "title": "CPU 사용률",
      "description": "트래픽 급증 시 CPU 부하 확인. Process CPU가 System CPU 대비 높으면 애플리케이션 병목.",
      "gridPos": { "x": 0, "y": 41, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "lineWidth": 2, "fillOpacity": 15 } } },
      "targets": [
        { "expr": "process_cpu_usage{job=\"hrguard-api\"}", "legendFormat": "Process CPU", "refId": "A" },
        { "expr": "system_cpu_usage{job=\"hrguard-api\"}", "legendFormat": "System CPU", "refId": "B" }
      ]
    },

    {
      "id": 62, "type": "timeseries",
      "title": "JVM 스레드",
      "description": "Live 스레드가 Peak에 근접하면 스레드 풀 포화 의심. 요청 처리 지연과 함께 나타나면 thread pool 크기 조정 검토.",
      "gridPos": { "x": 12, "y": 41, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "jvm_threads_live_threads{job=\"hrguard-api\"}", "legendFormat": "Live", "refId": "A" },
        { "expr": "jvm_threads_daemon_threads{job=\"hrguard-api\"}", "legendFormat": "Daemon", "refId": "B" },
        { "expr": "jvm_threads_peak_threads{job=\"hrguard-api\"}", "legendFormat": "Peak", "refId": "C" }
      ]
    },

    {
      "id": 63, "type": "stat",
      "title": "프로세스 가동 시간",
      "description": "예상치 못한 재시작 여부를 빠르게 확인.",
      "gridPos": { "x": 20, "y": 41, "w": 4, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "#8AB8FF", "value": null }] } } },
      "targets": [{ "expr": "process_uptime_seconds{job=\"hrguard-api\"}", "legendFormat": "Uptime", "refId": "A" }]
    },

    {
      "id": 70, "type": "row",
      "title": "GC (Garbage Collection)",
      "gridPos": { "x": 0, "y": 47, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 71, "type": "timeseries",
      "title": "GC 일시 정지 시간",
      "description": "GC pause time. 요청 처리 중 spike가 생기면 응답 지연 원인.",
      "gridPos": { "x": 0, "y": 48, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 1, "fillOpacity": 10 } } },
      "targets": [{ "expr": "rate(jvm_gc_pause_seconds_sum{job=\"hrguard-api\"}[1m])", "legendFormat": "GC pause ({{action}}, {{cause}})", "refId": "A" }]
    },

    {
      "id": 72, "type": "timeseries",
      "title": "GC 발생 빈도",
      "description": "분당 GC 횟수. 급증 시 힙 압박 신호.",
      "gridPos": { "x": 12, "y": 48, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 1, "fillOpacity": 10 } } },
      "targets": [{ "expr": "rate(jvm_gc_pause_seconds_count{job=\"hrguard-api\"}[1m])", "legendFormat": "GC 횟수/s ({{action}})", "refId": "A" }]
    },

    {
      "id": 73, "type": "timeseries",
      "title": "Old Gen 승격률",
      "description": "Young Gen에서 Old Gen으로 이동한 바이트/s. 급증 시 Minor GC가 감당 못하는 신호 → Major GC 유발 전조.",
      "gridPos": { "x": 0, "y": 54, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "lineWidth": 2, "fillOpacity": 15 } } },
      "targets": [{ "expr": "rate(jvm_gc_memory_promoted_bytes_total{job=\"hrguard-api\"}[1m])", "legendFormat": "승격률 (B/s)", "refId": "A" }]
    },

    {
      "id": 74, "type": "timeseries",
      "title": "메모리 할당률",
      "description": "초당 새 객체 생성량(Eden 소비 속도). 높을수록 Minor GC 빈도 상승.",
      "gridPos": { "x": 12, "y": 54, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "lineWidth": 2, "fillOpacity": 15 } } },
      "targets": [{ "expr": "rate(jvm_gc_memory_allocated_bytes_total{job=\"hrguard-api\"}[1m])", "legendFormat": "할당률 (B/s)", "refId": "A" }]
    },

    {
      "id": 80, "type": "row",
      "title": "HikariCP 커넥션 풀",
      "gridPos": { "x": 0, "y": 60, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 81, "type": "timeseries",
      "title": "커넥션 풀 상태 (Active / Idle / Max / Pending)",
      "description": "Pending 상승 = 풀 포화. Max에 Active가 달라붙으면 pool size 증설 필요.",
      "gridPos": { "x": 0, "y": 61, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Pending" }, "properties": [{ "id": "color", "value": { "fixedColor": "#E0B400", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Max" }, "properties": [{ "id": "custom.lineStyle", "value": { "dash": [8, 8], "fill": "dash" } }] }
        ]
      },
      "targets": [
        { "expr": "hikaricp_connections_active{job=\"hrguard-api\", pool=\"hrguard-domain\"}", "legendFormat": "Active", "refId": "A" },
        { "expr": "hikaricp_connections_idle{job=\"hrguard-api\", pool=\"hrguard-domain\"}", "legendFormat": "Idle", "refId": "B" },
        { "expr": "hikaricp_connections_max{job=\"hrguard-api\", pool=\"hrguard-domain\"}", "legendFormat": "Max", "refId": "C" },
        { "expr": "hikaricp_connections_pending{job=\"hrguard-api\", pool=\"hrguard-domain\"}", "legendFormat": "Pending", "refId": "D" }
      ]
    },

    {
      "id": 82, "type": "timeseries",
      "title": "커넥션 획득 대기 시간 (p50 / p95)",
      "description": "p95 > 50ms 이면 DB 부하 확인 필요.",
      "gridPos": { "x": 12, "y": 61, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [{ "matcher": { "id": "byName", "options": "p95" }, "properties": [{ "id": "color", "value": { "fixedColor": "#E02F44", "mode": "fixed" } }] }]
      },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(hikaricp_connections_acquire_seconds_bucket{job=\"hrguard-api\", pool=\"hrguard-domain\"}[$__rate_interval])))", "legendFormat": "p95", "refId": "A" },
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(hikaricp_connections_acquire_seconds_bucket{job=\"hrguard-api\", pool=\"hrguard-domain\"}[$__rate_interval])))", "legendFormat": "p50", "refId": "B" }
      ]
    },

    {
      "id": 83, "type": "stat",
      "title": "커넥션 타임아웃 누적",
      "description": "커넥션 획득 실패 횟수. 1 이상이면 즉시 풀 설정 점검.",
      "gridPos": { "x": 20, "y": 61, "w": 4, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "#3274D9", "value": null }, { "color": "#E02F44", "value": 1 }] } } },
      "targets": [{ "expr": "hikaricp_connections_timeout_total{job=\"hrguard-api\", pool=\"hrguard-domain\"}", "legendFormat": "타임아웃", "refId": "A" }]
    }

  ]
}
